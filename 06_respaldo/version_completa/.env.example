# Copia este archivo como .env y completa tus datos (el .env real NO se sube a Git).
# MongoDB local:
#   MONGO_URI=mongodb://localhost:27017
# MongoDB Atlas / clúster del profesor:
#   MONGO_URI=mongodb+srv://USUARIO:CONTRASEÑA@CLUSTER.mongodb.net/
# (si la contraseña tiene caracteres especiales como @ : / hay que codificarlos como URL)
MONGO_URI=mongodb://localhost:27017
# Usa un nombre propio si compartes el clúster con otros alumnos
MONGO_DB=control_accesos_db
